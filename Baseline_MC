ply.started":"2025-03-20T15:39:34.906145Z","shell.execute_reply":"2025-03-20T15:39:34.928935Z"}},"outputs":[],"execution_count":4},{"cell_type":"markdown","source":"### Early Stopper","metadata":{}},{"cell_type":"code","source":"class EarlyStopper:\n    \"\"\"Class for early stopping.\"\"\"\n    def __init__(self, patience=20, metric=\"valid_auc\", higher_is_better=True):\n        self.metric = metric\n        self.best_score = None\n        self.patience = patience\n        self.counter = 0\n        self.higher_is_better = higher_is_better\n\n    def update(self, score):\n        \"\"\"Updates early stopping counter and checks for stopping condition.\"\"\"\n        if self.best_score is None or (self.higher_is_better and score > self.best_score) or (not self.higher_is_better and score < self.best_score):\n            self.best_score = score\n            self.counter = 0\n            return True\n        self.counter += 1\n        return False\n\n    def should_stop(self):\n        \"\"\"Returns True if training should stop.\"\"\"\n        return self.counter >= self.patience","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-03-20T15:39:34.931986Z","iopub.execute_input":"2025-03-20T15:39:34.932411Z","iopub.status.idle":"2025-03-20T15:39:34.956443Z","shell.execute_reply.started":"2025-03-20T15:39:34.932367Z","shell.execute_reply":"2025-03-20T15:39:34.955136Z"}},"outputs":[],"execution_count":5},{"cell_type":"markdown","source":"## Rec Models","metadata":{}},{"cell_type":"markdown","source":"","metadata":{}},{"cell_type":"markdown","source":"### SASRec","metadata":{}},{"cell_type":"code","source":"import numpy as np\nfrom collections import defaultdict\nfrom sklearn.preprocessing import label_binarize\n\n\nclass MarkovChainRecommender:\n    def __init__(self, num_items, smoothing_factor=0.1, temporal_decay=0.95, max_lookahead=3, sampling_strategy=\"hybrid\", softmax_temperature=0.5, personalization_factor=0.3):\n        \"\"\"\n        Optimized Markov Chains-based Recommender with personalization, adaptive lookahead, and popularity-based smoothing.\n\n        Args:\n            num_items (int): Total number of items in the dataset.\n            smoothing_factor (float): Laplace smoothing to prevent zero probabilities.\n            temporal_decay (float): Exponential decay factor for weighting older transitions.\n            max_lookahead (int): Maximum steps ahead to predict.\n            sampling_strategy (str): \"top\" for argmax, \"sample\" for probabilistic, \"hybrid\" for mixed.\n            softmax_temperature (float): Temperature for softmax sampling.\n            personalization_factor (float): Weighting for user preference adjustments.\n        \"\"\"\n        self.num_items = num_items\n        self.smoothing_factor = smoothing_factor\n        self.temporal_decay = temporal_decay\n        self.max_lookahead = max_lookahead\n        self.sampling_strategy = sampling_strategy\n        self.softmax_temperature = softmax_temperature\n        self.personalization_factor = personalization_factor\n\n        self.transition_matrix = np.zeros((num_items, num_items))  # Transition probabilities\n        self.co_occurrence_matrix = np.zeros((num_items, num_items))  # Item co-occurrence matrix\n        self.item_popularity = np.zeros(num_items)  # Global item popularity scores\n        self.user_transition_adjustments = defaultdict(lambda: np.zeros((num_items, num_items)))  # Per-user transition preference adjustments\n\n    def train(self, sequences, user_ids):\n        \"\"\"\n        Train the Markov Chains model by computing transition probabilities, co-occurrence statistics, and user personalization.\n\n        Args:\n            sequences (list of lists): Each sequence is a list of item IDs that a user interacted with.\n            user_ids (list of ints): User IDs corresponding to the sequences.\n        \"\"\"\n        transition_counts = np.zeros((self.num_items, self.num_items))\n\n        for user_id, sequence in zip(user_ids, sequences):\n            for i in range(len(sequence) - 1):\n                for step in range(1, min(self.max_lookahead + 1, len(sequence) - i)):  # ✅ Adaptive Lookahead\n                    prev_item = sequence[i]\n                    next_item = sequence[i + step]\n\n                    # ✅ Apply Exponential Moving Average (EMA) for smoothing\n                    weight = self.temporal_decay ** (step - 1)\n                    transition_counts[prev_item, next_item] += weight\n\n                    # ✅ Update item co-occurrence matrix\n                    self.co_occurrence_matrix[prev_item, next_item] += 1\n\n                    # ✅ User personalization adjustments (tracks how often a user transitions)\n                    self.user_transition_adjustments[user_id][prev_item, next_item] += 1\n\n                # ✅ Track global item popularity\n                self.item_popularity[sequence[i]] += 1\n\n        # ✅ Normalize transition probabilities & Apply Laplace Smoothing\n        row_sums = transition_counts.sum(axis=1, keepdims=True)\n        self.transition_matrix = (transition_counts + self.smoothing_factor) / \\\n                                 (row_sums + self.smoothing_factor * self.num_items)\n\n        # ✅ Normalize item popularity\n        self.item_popularity /= self.item_popularity.sum()\n\n    def predict(self, user_ids, last_items):\n        \"\"\"\n        Predict next item based on the last interacted item using the transition matrix.\n\n        Args:\n            user_ids (list of ints): The user IDs corresponding to last interacted items.\n            last_items (list of ints): The last interacted item for each user.\n\n        Returns:\n            np.array: Predicted next items.\n        \"\"\"\n        predictions = []\n        for user_id, item in zip(user_ids, last_items):\n            if np.sum(self.transition_matrix[item]) == 0:\n                # ✅ Cold-start: Select most popular item instead of random\n                predictions.append(np.argmax(self.item_popularity))\n            else:\n                # ✅ Personalization: Blend user-specific transition weights\n                user_adjustments = self.user_transition_adjustments[user_id][item]\n                adjusted_transition_probs = (\n                    (1 - self.personalization_factor) * self.transition_matrix[item] +\n                    self.personalization_factor * user_adjustments\n                )\n\n                if self.sampling_strategy == \"top\":\n                    predictions.append(np.argmax(adjusted_transition_probs))  # Most probable transition\n                elif self.sampling_strategy == \"sample\":\n                    predictions.append(np.random.choice(np.arange(self.num_items), p=adjusted_transition_probs))  # Random sampling\n                elif self.sampling_strategy == \"hybrid\":\n                    # ✅ Weighted Probability Adjustment (WPA) for better prediction\n                    softmax_probs = np.exp(adjusted_transition_probs / self.softmax_temperature)\n                    softmax_probs /= softmax_probs.sum()\n                    adjusted_probs = 0.8 * softmax_probs + 0.2 * self.item_popularity  # Mix item popularity with transition probabilities\n                    predictions.append(np.argmax(adjusted_probs))\n        return np.array(predictions)\n\n    def get_prediction_probs(self, last_items):\n        \"\"\"\n        Get the transition probability for the predicted next item.\n\n        Args:\n            last_items (list of ints): The last interacted item for each user.\n\n        Returns:\n            np.array: Transition probabilities for the predicted items.\n        \"\"\"\n        probabilities = []\n        for item in last_items:\n            if np.sum(self.transition_matrix[item]) == 0:\n                probabilities.append(np.max(self.item_popularity))  # ✅ Cold-start fallback probability\n            else:\n                probabilities.append(np.max(self.transition_matrix[item]))  # Highest probability transition\n        return np.array(probabilities)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-03-20T15:59:14.812741Z","iopub.execute_input":"2025-03-20T15:59:14.813140Z","iopub.status.idle":"2025-03-20T15:59:14.829564Z","shell.execute_reply.started":"2025-03-20T15:59:14.813113Z","shell.execute_reply":"2025-03-20T15:59:14.828265Z"}},"outputs":[],"execution_count":35},{"cell_type":"code","source":"from sklearn.preprocessing import label_binarize\n\ndef evaluate_markov_chain(model, data_loader, device=\"cpu\"):\n    \"\"\"\n    Evaluates the Markov Chain recommender system and computes AUC, uAUC, and other metrics.\n\n    Args:\n        model (MarkovChainRecommender): The trained Markov Chain model.\n        data_loader (DataLoader): DataLoader containing test sequences and labels.\n        device (str): Device to run the evaluation.\n\n    Returns:\n        dict: Evaluation metrics.\n    \"\"\"\n    predictions, labels, users, probs = [], [], [], []\n\n    with torch.no_grad():\n        for batch in data_loader:\n            user_ids, _, history, batch_labels = batch\n            user_ids, history, batch_labels = user_ids.cpu().numpy(), history.cpu().numpy(), batch_labels.cpu().numpy()\n\n            last_items = history[:, -1]  # Get last interacted item for each user\n            predicted_items = model.predict(user_ids, last_items)  # ✅ Fixed: Now passing user_ids\n            predicted_probs = model.get_prediction_probs(last_items)  # ✅ No change\n\n            # Store results\n            predictions.extend(predicted_items)\n            labels.extend(batch_labels)\n            users.extend(user_ids)\n            probs.extend(predicted_probs)\n\n    # Convert to NumPy arrays\n    predictions, labels, users, probs = map(np.array, [predictions, labels, users, probs])\n\n    # ✅ Compute One-vs-Rest (OvR) AUC\n    num_classes = model.num_items\n    labels_one_hot = label_binarize(labels, classes=np.arange(num_classes))\n\n    try:\n        auc = roc_auc_score(labels_one_hot, probs[:, None], average=\"macro\", multi_class=\"ovr\")\n    except ValueError:\n        auc = 0.0  # If AUC calculation fails due to single-class labels\n\n    # ✅ Compute uAUC (User-Level AUC)\n    uauc = calculate_uauc(users, probs, labels)\n\n    # ✅ Compute Other Metrics\n    accuracy = accuracy_score(labels, predictions)\n    precision = precision_score(labels, predictions, average=\"macro\", zero_division=0)\n    recall = recall_score(labels, predictions, average=\"macro\", zero_division=0)\n    f1 = f1_score(labels, predictions, average=\"macro\", zero_division=0)\n    log_loss_value = log_loss(labels, probs)\n\n    # ✅ Return evaluation metrics\n    results = {\n        \"auc\": auc,\n        \"uauc\": uauc,\n        \"accuracy\": accuracy,\n        \"precision\": precision,\n        \"recall\": recall,\n        \"f1_score\": f1,\n        \"log_loss\": log_loss_value,\n    }\n\n    return results","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-03-20T16:10:02.448231Z","iopub.execute_input":"2025-03-20T16:10:02.448712Z","iopub.status.idle":"2025-03-20T16:10:02.463231Z","shell.execute_reply.started":"2025-03-20T16:10:02.448653Z","shell.execute_reply":"2025-03-20T16:10:02.461734Z"}},"outputs":[],"execution_count":42},{"cell_type":"markdown","source":"## Database Classes","metadata":{}},{"cell_type":"code","source":"class SequenceDataset(Dataset):\n    \"\"\"Dataset class for sequential data.\"\"\"\n    def __init__(self, data, max_len=25):\n        self.data = data\n        self.max_len = max_len\n\n    def __len__(self):\n        return len(self.data)\n\n    def __getitem__(self, index):\n        uid, iid, history, label = self.data[index]\n        history = np.pad(history[-self.max_len:], (self.max_len - len(history), 0), 'constant') if len(history) < self.max_len else np.array(history[-self.max_len:])\n        return uid, iid, history, label","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-03-20T15:39:34.979180Z","iopub.execute_input":"2025-03-20T15:39:34.979461Z","iopub.status.idle":"2025-03-20T15:39:35.004945Z","shell.execute_reply.started":"2025-03-20T15:39:34.979435Z","shell.execute_reply":"2025-03-20T15:39:35.003040Z"}},"outputs":[],"execution_count":7},{"cell_type":"code","source":"def extract_user_ids(dataset):\n    \"\"\"Extract user IDs from the dataset.\"\"\"\n    user_ids = []\n    sequences = []\n    \n    for uid, _, history, _ in dataset:\n        user_ids.append(uid)\n        sequences.append(history)\n\n    return user_ids, sequences\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-03-20T16:05:05.109194Z","iopub.execute_input":"2025-03-20T16:05:05.109615Z","iopub.status.idle":"2025-03-20T16:05:05.116229Z","shell.execute_reply.started":"2025-03-20T16:05:05.109585Z","shell.execute_reply":"2025-03-20T16:05:05.114848Z"}},"outputs":[],"execution_count":38},{"cell_type":"markdown","source":"## Training & Evaluation Logic","metadata":{}},{"cell_type":"code","source":"def train_one_epoch(model, data_loader, optimizer, criterion, device):\n    \"\"\"Performs one training epoch.\"\"\"\n    model.train()\n    epoch_loss = 0.0\n\n    for batch in data_loader:\n        # user_ids, item_ids, history, labels = (x.to(device) for x in batch)\n        # print(\"DEBUG!!!\")\n        # print(batch)\n        user_ids, item_ids, history, labels = (x for x in batch)\n        outputs = model(history.long(), item_ids.long())\n        loss = criterion(outputs, labels.float())\n\n        optimizer.zero_grad()\n        loss.backward()\n        optimizer.step()\n        epoch_loss += loss.item()\n\n    return epoch_loss / len(data_loader)\n\ndef evaluate_model(model, data_loader, device='cpu'):\n    \"\"\"Evaluates the model and computes multiple metrics.\"\"\"\n    model.eval()\n    predictions, labels, users = [], [], []\n\n    with torch.no_grad():\n        for batch in data_loader:\n         