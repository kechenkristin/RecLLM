tience=20):\n        self.ref_metric = ref_metric\n        self.increase = increase\n        self.patience = patience\n        self.best_metric = None\n        self.reach_count = 0\n\n    def update(self, metrics):\n        current_value = metrics[self.ref_metric]\n        if self.best_metric is None or (self.increase and current_value > self.best_metric[self.ref_metric]) or \\\n                (not self.increase and current_value < self.best_metric[self.ref_metric]):\n            self.best_metric = metrics\n            self.reach_count = 0\n            return True\n        else:\n            self.reach_count += 1\n            return False\n\n    def should_stop(self):\n        return self.reach_count >= self.patience","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-03-19T18:11:38.323080Z","iopub.execute_input":"2025-03-19T18:11:38.323536Z","iopub.status.idle":"2025-03-19T18:11:38.343602Z","shell.execute_reply.started":"2025-03-19T18:11:38.323492Z","shell.execute_reply":"2025-03-19T18:11:38.342452Z"}},"outputs":[],"execution_count":43},{"cell_type":"markdown","source":"## Model","metadata":{}},{"cell_type":"code","source":"class MatrixFactorization(nn.Module):\n    # here we does not consider the bais term \n    def __init__(self, rec_config, *args, **kwargs) -> None:\n        super().__init__()\n        self.padding_index = 0\n        self.rec_config = rec_config\n\n        self.user_embedding = nn.Embedding(self.rec_config.user_num, self.rec_config.embedding_size, padding_idx=self.padding_index)\n        self.item_embedding = nn.Embedding(self.rec_config.item_num, self.rec_config.embedding_size, padding_idx=self.padding_index)\n        print(\"creat MF model, user num:\", self.rec_config.user_num, \"item num:\", self.rec_config.item_num)\n\n    def user_encoder(self,users,all_users=None):\n        # print(\"user max:\", users.max(), users.min())\n        return self.user_embedding(users)\n        \n    def item_encoder(self,items,all_items=None):\n        # print(\"items max:\", items.max(), items.min())\n        return self.item_embedding(items)\n    \n    def computer(self): # does not need to compute user reprensentation, directly taking the embedding as user/item representations\n        return None, None\n    \n    def forward(self,users,items):\n        user_embedding = self.user_embedding(users)\n        item_embedding = self.item_embedding(items)\n        matching = torch.mul(user_embedding, item_embedding).sum(dim=-1)\n        return matching","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-03-19T18:11:38.344738Z","iopub.execute_input":"2025-03-19T18:11:38.345122Z","iopub.status.idle":"2025-03-19T18:11:38.366869Z","shell.execute_reply.started":"2025-03-19T18:11:38.345083Z","shell.execute_reply":"2025-03-19T18:11:38.365685Z"}},"outputs":[],"execution_count":44},{"cell_type":"code","source":"import torch.nn as nn\n\nclass NCF(nn.Module):\n    def __init__(self, rec_config):\n        super(NCF, self).__init__()\n        self.rec_config = rec_config\n        self.user_embedding = nn.Embedding(self.rec_config.user_num, self.rec_config.embedding_size)\n        self.item_embedding = nn.Embedding(self.rec_config.item_num, self.rec_config.embedding_size)\n        self.fc_layers = nn.Sequential(\n            nn.Linear(2 * self.rec_config.embedding_size, 512),  # ✅ Input must be 2 * embedding_dim\n            nn.ReLU(),\n            nn.Linear(512, 256),\n            nn.ReLU(),\n            nn.Linear(256, 128),\n            nn.ReLU(),\n            nn.Linear(128, 1),  # ✅ Output a single score\n        )\n\n    def forward(self, user_ids, item_ids):\n        \"\"\"\n        Forward pass of NCF.\n\n        Args:\n            user_ids (torch.Tensor): Tensor of user IDs.\n            item_ids (torch.Tensor): Tensor of item IDs.\n\n        Returns:\n            torch.Tensor: Predicted interaction score.\n        \"\"\"\n        # # ✅ Fetch embeddings\n        # user_emb = self.user_embedding(user_ids)  # Shape: (batch_size, embedding_dim)\n        # item_emb = self.item_embedding(item_ids)  # Shape: (batch_size, embedding_dim)\n\n        # # ✅ Concatenate embeddings along the last dimension\n        # x = torch.cat([user_emb, item_emb], dim=-1)  # Shape: (batch_size, 2 * embedding_dim)\n\n        # # ✅ Pass through FC layers\n        # return torch.sigmoid(self.fc_layers(x)).squeeze(-1)\n\n\n        user_emb = self.user_embedding(user_ids)\n        item_emb = self.item_embedding(item_ids)\n        \n        # 🔼 Normalize embeddings to unit vectors\n        user_emb = user_emb / torch.norm(user_emb, dim=-1, keepdim=True)\n        item_emb = item_emb / torch.norm(item_emb, dim=-1, keepdim=True)\n        \n        x = torch.cat([user_emb, item_emb], dim=-1)\n        return torch.sigmoid(self.fc_layers(x)).squeeze(-1)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-03-19T21:51:06.424690Z","iopub.execute_input":"2025-03-19T21:51:06.425064Z","iopub.status.idle":"2025-03-19T21:51:06.433307Z","shell.execute_reply.started":"2025-03-19T21:51:06.425037Z","shell.execute_reply":"2025-03-19T21:51:06.432091Z"}},"outputs":[],"execution_count":141},{"cell_type":"code","source":"def log_and_print_metrics(cur_epoch, val_log):\n        \"\"\"\n        Saves validation metrics to a JSON file and prints them dynamically using key-value pairs.\n\n        Args:\n            cur_epoch (int): The current epoch number.\n            val_log (dict): A dictionary containing validation metrics such as loss, auc, uauc, etc.\n\n        Raises:\n            AssertionError: If val_log is empty.\n        \"\"\"\n        # Ensure val_log is not empty\n        assert val_log, \"Validation log is empty. Cannot log metrics.\"\n\n        # Prepare the metrics message dynamically\n        metrics_message = [f\"Epoch {cur_epoch} Metrics:\"]\n        for key, value in val_log.items():\n            # Handle float formatting for numeric values\n            if isinstance(value, (float, int)):\n                metrics_message.append(f\"  {key.capitalize()}: {value:.4f}\")\n            else:\n                metrics_message.append(f\"  {key.capitalize()}: {value}\")\n\n        # Join all parts into a single message\n        message = \"\\n\".join(metrics_message)\n\n        # Save metrics to JSON\n        log_data = {\"epoch\": cur_epoch, **val_log}  # Include the current epoch in the JSON entry\n        # print(\"DEBUG!!! I am in log_and_print_metrics\")\n        # print(log_data)\n        \n        try:\n            with open(JSON_LOG_PATH, \"a\", encoding=\"utf-8\") as f:\n                json.dump(log_data, f, indent=4)\n            # with open(JSON_LOG_PATH, \"a\", encoding=\"utf-8\") as f:\n            #     print(\"DEBUG!!!\")\n            #     print(json.dumps(log_data, indent=4))\n            #     f.write(json.dumps(log_data) + \"\\n\")\n        except Exception as e:\n            print(f\"Error saving metrics to JSON: {e}\")\n\n        # Print the message\n        print(message)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-03-19T20:07:46.777112Z","iopub.execute_input":"2025-03-19T20:07:46.777529Z","iopub.status.idle":"2025-03-19T20:07:46.784899Z","shell.execute_reply.started":"2025-03-19T20:07:46.777495Z","shell.execute_reply":"2025-03-19T20:07:46.783578Z"}},"outputs":[],"execution_count":74},{"cell_type":"code","source":"def enable_dropout(model):\n    \"\"\"Re-enables dropout layers during evaluation.\"\"\"\n    for module in model.modules():\n        if isinstance(module, torch.nn.Dropout):\n            module.train()  # Keep dropout active even in eval mode","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-03-19T20:03:05.318395Z","iopub.execute_input":"2025-03-19T20:03:05.318784Z","iopub.status.idle":"2025-03-19T20:03:05.324055Z","shell.execute_reply.started":"2025-03-19T20:03:05.318755Z","shell.execute_reply":"2025-03-19T20:03:05.322901Z"}},"outputs":[],"execution_count":71},{"cell_type":"code","source":"def add_noise_to_factors(tensor, scale=1e-3):\n    \"\"\"Adds small Gaussian noise to break deterministic outputs.\"\"\"\n    return tensor + scale * torch.randn_like(tensor)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-03-19T20:12:49.223790Z","iopub.execute_input":"2025-03-19T20:12:49.224202Z","iopub.status.idle":"2025-03-19T20:12:49.228793Z","shell.execute_reply.started":"2025-03-19T20:12:49.224169Z","shell.execute_reply":"2025-03-19T20:12:49.227713Z"}},"outputs":[],"execution_count":77},{"cell_type":"code","source":"def evaluate_model(model, data_loader, device):\n    \"\"\"Evaluates the model and computes multiple metrics.\"\"\"\n    model.eval()\n    predictions, labels, users = [], [], []\n\n    with torch.no_grad():\n        for batch in data_loader:\n            user_ids, item_ids, label = batch[:, 0], batch[:, 1], batch[:, 2]\n\n            \n            scores = model(user_ids.to(device), item_ids.to(device))\n\n            predictions.extend(scores.cpu().numpy())\n            labels.extend(label.cpu().numpy())\n            users.extend(user_ids.cpu().numpy())\n\n    # Convert to NumPy arrays\n    predictions = np.array(predictions)\n    labels = np.array(labels)\n    users = np.array(users)\n\n    # Compute AUC & uAUC\n    auc = roc_auc_score(labels, predictions)\n    uauc = calculate_uauc(users, predictions, labels)\n\n    # Convert logits to probabilities using sigmoid\n    probabilities = 1 / (1 + np.exp(-predictions))\n\n    # Compute additional evaluation metrics\n    accuracy = accuracy_score(labels, (probabilities > 0.5).astype(int))\n    precision = precision_score(labels, (probabilities > 0.5).astype(int), zero_division=0)\n    recall = recall_score(labels, (probabilities > 0.5).astype(int), zero_division=0)\n    f1 = f1_score(labels, (probabilities > 0.5).astype(int), zero_division=0)\n    log_loss_value = log_loss(labels, probabilities)\n\n    # Return results as a dictionary\n    results = {\n        \"auc\": auc,\n        \"uauc\": uauc,\n        \"accuracy\": accuracy,\n        \"precision\": precision,\n        \"recall\": recall,\n        \"f1_score\": f1,\n        \"log_loss\": log_loss_value,\n    }\n\n    return results\n\n\n\ndef train_one_epoch(model, train_loader, optimizer, criterion, device='cpu'):\n    \"\"\"\n    Perform one epoch of training.\n\n    Args:\n        model (nn.Module): The model to train.\n        train_loader (DataLoader): DataLoader for training data.\n        optimizer (torch.optim.Optimizer): Optimizer for training.\n        criterion (nn.Module): Loss function for training.\n        device (str): Device to run training on. Defaults to 'cpu'.\n\n    Returns:\n        float: The average loss for the epoch.\n    \"\"\"\n    model.train()\n    epoch_loss = 0.0\n\n    for batch in train_loader:\n        # Extract inputs and labels from batch\n        user_ids, item_ids, labels = batch[:, 0], batch[:, 1], batch[:, 2]\n        \n        # Forward pass\n        scores = model(user_ids.to(device), item_ids.to(device))\n        loss = criterion(scores, labels.float().to(device))\n\n\n        # ✅ Debug: Check if gradients are updating\n        # for name, param in model.named_parameters():\n        #     if param.requires_grad and param.grad is not None:\n        #         print(f\"Gradient for {name}: {param.grad.abs().mean().item():.6f}\")\n        \n        # Backward pass\n        optimizer.zero_grad()\n        loss.backward()\n        optimizer.step()\n\n        \n        # Accumulate loss\n        epoch_loss += loss.item()\n\n    # Return average loss\n    return epoch_loss / len(train_loader)\n\n\ndef save_training_log(log_data, json_log_path=\"training_log.json\"):\n    \"\"\"\n    Saves the entire training log list into a JSON file.\n\n    Args:\n        log_data (list): List of dictionaries containing training logs for each epoch.\n        json_log_path (str): File path to save the training logs as JSON.\n    \"\"\"\n    # Ensure directory exists\n    os.makedirs(os.path.dirname(json_log_path), exist_ok=True)\n\n    # Save logs to JSON file\n    with open(json_log_path, \"w\", encoding=\"utf-8\") as f:\n        json.dump(log_data, f, indent=4)\n\n    print(f\"Training log saved at: {json_log_path}\")\n\n# Updated train function\ndef train_and_evaluate(train_config, data_loaders, model, optimizer, criterion, early_stopper, save_path=None, device='cpu'):\n    \"\"\"\n    Train and evaluate the model using the given configuration and components.\n    \"\"\"\n\n    train_loader = data_loaders['train']\n    valid_loader = data_loaders['valid']\n\n    final_log = []  # ✅ Keep track of all epochs\n\n    for epoch in range(train_config['epoch']):\n        # Training phase\n        train_loss = train_one_epoch(model, train_loader, optimizer, criterion, device)\n        print(f\"Epoch {epoch}, Training Loss: {train_loss:.4f}\")\n\n        # Evaluate periodically\n        if epoch % train_config['eval_epoch'] == 0:\n            val_log = evaluate_model(model, valid_loader, device)\n            if val_log is not None:\n                val_log.update({\"epoch\": epoch})\n                log_and_print_metrics(epoch, val_log)\n                final_log.append(val_log)  # ✅ Accumulate logs correctly\n            \n            # Extract metrics\n            valid_auc = val_log[\"auc\"]\n            valid_uauc = val_log[\"uauc\"]\n\n            # Early stopping logic\n            if early_stopper.update({'valid_auc': valid_auc, 'valid_uauc': valid_uauc}):\n                if save_path:\n                    torch.save(model.state_dict(), save_path)\n\n            if early_stopper.should_stop():\n                print(\"Early stopping triggered.\")\n                torch.save(model.state_dict(), \"/kaggle/working/checkpoint_best_mf.pth\")\n                break\n\n    print(\"Training complete. Best metrics:\", early_stopper.best_metric)\n\n    # ✅ Save the entire training log at the end\n    save_training_log(final_