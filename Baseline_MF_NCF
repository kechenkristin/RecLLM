")\n\n    enable_dropout(model)\n\n    # ✅ Initialize storage for multiple runs\n    metric_records = defaultdict(list)\n\n    for i in range(num_eval_runs):\n        print(f\"Running evaluation {i + 1}/{num_eval_runs}...\")\n\n        # ✅ Reset randomness for fair testing\n        setup_seeds(seed=42 + i)  # Changing seed slightly per run\n\n        # ✅ Perform evaluation\n        with torch.no_grad():\n            test_metrics = evaluate_model(model, data_loader, device)\n\n        # ✅ Store results for analysis\n        for key, value in test_metrics.items():\n            metric_records[key].append(value)\n\n        log_and_print_metrics(i, test_metrics)\n        # ✅ Save each run to JSON (appending new logs)\n        eval_log_path = \"metrics_log_eval_mf_movie.json\"\n        with open(eval_log_path, \"a\", encoding=\"utf-8\") as f:\n            f.write(json.dumps(test_metrics) + \"\\n\")\n\n    # ✅ Compute statistics\n    avg_metrics = {key: np.mean(values) for key, values in metric_records.items()}\n    std_metrics = {key: np.std(values) for key, values in metric_records.items()}\n\n    print(\"\\n=== Final Averaged Evaluation Metrics ===\")\n    for key in avg_metrics.keys():\n        print(f\"{key}: {avg_metrics[key]:.4f} ± {std_metrics[key]:.4f}\")\n\n    print(f\"Evaluation results saved to: {eval_log_path}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-03-19T20:16:36.537389Z","iopub.execute_input":"2025-03-19T20:16:36.537821Z","iopub.status.idle":"2025-03-19T20:16:36.547559Z","shell.execute_reply.started":"2025-03-19T20:16:36.537788Z","shell.execute_reply":"2025-03-19T20:16:36.546356Z"}},"outputs":[],"execution_count":90},{"cell_type":"markdown","source":"## Training Preparation","metadata":{}},{"cell_type":"code","source":"set_random_seed()\n\n# Load datasets\ntrain_data_movie = load_data(movie_data_dir, \"train_ood2.pkl\")\nvalid_data_movie = load_data(movie_data_dir, \"valid_ood2.pkl\")\ntest_data_movie = load_data(movie_data_dir