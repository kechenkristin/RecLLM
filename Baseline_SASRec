s).squeeze()\n    unique_users, inverse_indices, counts = np.unique(user, return_inverse=True, return_counts=True)\n\n    aucs = []\n    for user_id in unique_users:\n        indices = np.where(user == user_id)\n        user_preds, user_labels = predictions[indices], labels[indices]\n        try:\n            aucs.append(roc_auc_score(user_labels, user_preds))\n        except ValueError:\n            continue\n\n    return np.mean(aucs) if aucs else 0","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-03-20T09:58:51.039303Z","iopub.execute_input":"2025-03-20T09:58:51.039593Z","iopub.status.idle":"2025-03-20T09:58:51.062360Z","shell.execute_reply.started":"2025-03-20T09:58:51.039557Z","shell.execute_reply":"2025-03-20T09:58:51.061253Z"}},"outputs":[],"execution_count":4},{"cell_type":"markdown","source":"### Early Stopper","metadata":{}},{"cell_type":"code","source":"class EarlyStopper:\n    \"\"\"Class for early stopping.\"\"\"\n    def __init__(self, patience=20, metric=\"valid_auc\", higher_is_better=True):\n        self.metric = metric\n        self.best_score = None\n        self.patience = patience\n        self.counter = 0\n        self.higher_is_better = higher_is_better\n\n    def update(self, score):\n        \"\"\"Updates early stopping counter and checks for stopping condition.\"\"\"\n        if self.best_score is None or (self.higher_is_better and score > self.best_score) or (not self.higher_is_better and score < self.best_score):\n            self.best_score = score\n            self.counter = 0\n            return True\n        self.counter += 1\n        return False\n\n    def should_stop(self):\n        \"\"\"Returns True if training should stop.\"\"\"\n        return self.counter >= self.patience","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-03-20T09:58:51.063245Z","iopub.execute_input":"2025-03-20T09:58:51.063680Z","iopub.status.idle":"2025-03-20T09:58:51.085962Z","shell.execute_reply.started":"2025-03-20T09:58:51.063613Z","shell.execute_reply":"2025-03-20T09:58:51.084672Z"}},"outputs":[],"execution_count":5},{"cell_type":"markdown","source":"## Rec Models","metadata":{}},{"cell_type":"markdown","source":"### SASRec","metadata":{}},{"cell_type":"code","source":"class PointWiseFeedForward(nn.Module):\n    def __init__(self, hidden_units, dropout_rate):\n\n        super(PointWiseFeedForward, self).__init__()\n\n        self.conv1 = torch.nn.Conv1d(hidden_units, hidden_units, kernel_size=1)\n        self.dropout1 = torch.nn.Dropout(p=dropout_rate)\n        self.relu = torch.nn.ReLU()\n        self.conv2 = torch.nn.Conv1d(hidden_units, hidden_units, kernel_size=1)\n        self.dropout2 = torch.nn.Dropout(p=dropout_rate)\n\n    def forward(self, inputs):\n        outputs = self.dropout2(self.conv2(self.relu(self.dropout1(self.conv1(inputs.transpose(-1, -2))))))\n        outputs = outputs.transpose(-1, -2) # as Conv1D requires (N, C, Length)\n        outputs += inputs\n        return outputs","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-03-20T09:58:51.087155Z","iopub.execute_input":"2025-03-20T09:58:51.087514Z","iopub.status.idle":"2025-03-20T09:58:51.107258Z","shell.execute_reply.started":"2025-03-20T09:58:51.087470Z","shell.execute_reply":"2025-03-20T09:58:51.106030Z"}},"outputs":[],"execution_count":6},{"cell_type":"code","source":"class SASRec(nn.Module):\n    def __init__(self, rec_sasrec_config):\n        super(SASRec, self).__init__()\n        self.rec_config = rec_sasrec_config\n        \n        # TODO: loss += args.l2_emb for regularizing embedding vectors during training\n        # https://stackoverflow.com/questions/42704283/adding-l1-l2-regularization-in-pytorch\n        self.item_emb = torch.nn.Embedding(self.item_num, self.hidden_units, padding_idx=0)\n        self.pos_emb = torch.nn.Embedding(self.maxlen, self.hidden_units) # TO IMPROVE\n        self.emb_dropout = torch.nn.Dropout(p=self.dropout_rate)\n        self.padding_index = 0\n\n        self.attention_layernorms = torch.nn.ModuleList() # to be Q for self-attention\n        self.attention_layers = torch.nn.ModuleList()\n        self.forward_layernorms = torch.nn.ModuleList()\n        self.forward_layers = torch.nn.ModuleList()\n        self.last_layernorm = torch.nn.LayerNorm(self.hidden_units, eps=1e-8)\n\n        for _ in range(self.num_blocks):\n            new_attn_layernorm = torch.nn.LayerNorm(self.hidden_units, eps=1e-8)\n            self.attention_layernorms.append(new_attn_layernorm)\n\n            new_attn_layer =  torch.nn.MultiheadAttention(self.hidden_units,\n                                                            self.num_heads,\n                                                            self.dropout_rate)\n            self.attention_layers.append(new_attn_layer)\n\n            new_fwd_layernorm = torch.nn.LayerNorm(self.hidden_units, eps=1e-8)\n            self.forward_layernorms.append(new_fwd_layernorm)\n\n            new_fwd_layer = PointWiseFeedForward(self.hidden_units, self.dropout_rate)\n            self.forward_layers.append(new_fwd_layer)\n\n        \n    @property\n    def user_num(self):\n        return self.rec_config.user_num\n\n    @property\n    def item_num(self):\n        return self.rec_config.item_num\n\n    @property\n    def embedding_size(self):\n        return self.rec_config.embedding_size\n\n    @property\n    def hidden_units(self):\n        return self.rec_config.hidden_units\n\n    @property\n    def num_blocks(self):\n        return self.rec_config.num_blocks\n\n    @property\n    def num_heads(self):\n        return self.rec_config.num_heads\n\n    @property\n    def dropout_rate(self):\n        return self.rec_config.dropout_rate\n\n    @property\n    def l2_emb(self):\n        return self.rec_config.l2_emb  # Not used\n\n    @property\n    def maxlen(self):\n        return self.rec_config.maxlen\n    \n    def _device(self):\n        self.dev = self.item_emb.weight.device\n\n    def log2feats(self, log_seqs):\n        # seqs = self.item_emb(log_seqs.to(self.dev))\n        seqs = self.item_emb(log_seqs)\n        seqs *= self.item_emb.embedding_dim ** 0.5\n        positions = np.tile(np.array(range(log_seqs.shape[1])), [log_seqs.shape[0], 1])\n        seqs += self.pos_emb(torch.LongTensor(positions).to(self.dev))\n        seqs = self.emb_dropout(seqs)\n\n        timeline_mask = torch.BoolTensor(log_seqs.cpu().numpy() == 0).to(self.dev)\n        seqs *= ~timeline_mask.unsqueeze(-1) # broadcast in last dim\n\n        tl = seqs.shape[1] # time dim len for enforce causality\n        attention_mask = ~torch.tril(torch.ones((tl, tl), dtype=torch.bool, device=self.dev))\n\n        for i in range(len(self.attention_layers)):\n            seqs = torch.transpose(seqs, 0, 1)\n            Q = self.attention_layernorms[i](seqs)\n            mha_outputs, _ = self.attention_layers[i](Q, seqs, seqs, \n                                            attn_mask=attention_mask)\n            seqs = Q + mha_outputs\n            seqs = torch.transpose(seqs, 0, 1)\n\n            seqs = self.forward_layernorms[i](seqs)\n            seqs = self.forward_layers[i](seqs)\n            seqs *=  ~timeline_mask.unsqueeze(-1)\n\n        log_feats = self.last_layernorm(seqs) # (U, T, C) -> (U, -1, C)\n\n        return log_feats\n\n    def forward_eval(self, user_ids, target_item, log_seqs): # for training\n        self._device()        \n        log_feats = self.log2feats(log_seqs) # user_ids hasn't been used yet\n\n        log_feats = log_feats[:,-1,:]\n        item_embs = self.item_emb(target_item)\n        return (log_feats*item_embs).sum(dim=-1)\n\n        # return pos_logits, neg_logits # pos_pred, neg_pred\n    def forward(self, seqs, target, target_posi=None):\n        self._device()    \n        log_feats = self.log2feats(seqs)\n        if target_posi is not None:\n            s_emb = log_feats[target_posi[:,0], target_posi[:,1]]\n        else:\n            s_emb = log_feats[:,-1,:]\n        target_embeds = self.item_emb(target.reshape(-1))\n        scores = torch.mul(s_emb, target_embeds).sum(dim=-1)\n        return scores\n    \n    def computer(self): # does not need to compute user reprensentation, directly taking the embedding as user/item representations\n        return None, None\n    \n    def seq_encoder(self, seqs): # seq embedding server as user embedding for CollabRec\n        self._device()\n        log_feats = self.log2feats(seqs)\n        seq_emb = log_feats[:,-1,:]\n        return seq_emb\n    \n    def item_encoder(self,target_item,all_items=None):\n        self._device()\n        target_embeds = self.item_emb(target_item)\n        return target_embeds\n\n    def predict(self, user_ids, log_seqs, item_indices): # for inference\n        log_feats = self.log2feats(log_seqs) # user_ids hasn't been used yet\n\n        final_feat = log_feats[:, -1, :] # only use last QKV classifier, a waste\n\n        item_embs = self.item_emb(torch.LongTensor(item_indices).to(self.dev)) # (U, I, C)\n\n        logits = item_embs.matmul(final_feat.unsqueeze(-1)).squeeze(-1)\n\n\n        return logits # preds # (U, I)\n    \n    def predict_all(self, user_ids, log_seqs):\n        log_feats = self.log2feats(log_seqs) # user_ids hasn't been used yet\n\n        final_feat = log_feats[:, -1, :] # only use last QKV classifier, a waste\n\n        item_embs = self.item_emb.weight\n\n        logits = torch.matmul(final_feat, item_embs.T)\n\n        return logits # preds # (U, I)\n    \n    def predict_all_batch(self, user_ids, log_seqs,batch_size=128):\n        log_feats = self.log2feats(log_seqs) # user_ids hasn't been used yet\n\n        final_feat = log_feats[:, -1, :] # only use last QKV classifier, a waste\n\n        item_embs = self.item_emb.weight\n\n        # logits = item_embs.matmul(final_feat.unsqueeze(-1)).squeeze(-1)\n        logits = torch.matmul(final_feat,item_embs.T)\n\n        # preds = self.pos_sigmoid(logits) # rank same item list for different users\n\n        return logits # preds # (U, I)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-03-20T09:58:51.108467Z","iopub.execute_input":"2025-03-20T09:58:51.108871Z","iopub.status.idle":"2025-03-20T09:58:51.143476Z","shell.execute_reply.started":"2025-03-20T09:58:51.108836Z","shell.execute_reply":"2025-03-20T09:58:51.141636Z"}},"outputs":[],"execution_count":7},{"cell_type":"markdown","source":"## Database Classes","metadata":{}},{"cell_type":"code","source":"class SequenceDataset(Dataset):\n    \"\"\"Dataset class for sequential data.\"\"\"\n    def __init__(self, data, max_len=25):\n        self.data = data\n        self.max_len = max_len\n\n    def __len__(self):\n        return len(self.data)\n\n    def __getitem__(self, index):\n        uid, iid, history, label = self.data[index]\n        history = np.pad(history[-self.max_len:], (self.max_len - len(history), 0), 'constant') if len(history) < self.max_len else np.array(history[-self.max_len:])\n        return uid, iid, history, label","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-03-20T09:58:51.144836Z","iopub.execute_input":"2025-03-20T09:58:51.145232Z","iopub.status.idle":"2025-03-20T09:58:51.169070Z","shell.execute_reply.started":"2025-03-20T09:58:51.145188Z","shell.execute_reply":"2025-03-20T09:58:51.167702Z"}},"outputs":[],"execution_count":8},{"cell_type":"markdown","source":"## Training & Evaluation Logic","metadata":{}},{"cell_type":"code","source":"def train_one_epoch(model, data_loader, optimizer, criterion, device):\n    \"\"\"Performs one training epoch.\"\"\"\n    model.train()\n    epoch_loss = 0.0\n\n    for batch in data_loader:\n        # user_ids, item_ids, history, labels = (x.to(device) for x in batch)\n        # print(\"DEBUG!!!\")\n        # print(batch)\n        user_ids, item_ids, history, labels = (x for x in batch)\n        outputs = model(history.long(), item_ids.long())\n        loss = criterion(outputs, labels.float())\n\n        optimizer.zero_grad()\n        loss.backward()\n        optimizer.step()\n        epoch_loss += loss.item()\n\n    return epoch_loss / len(data_loader)\n\ndef evaluate_model(model, data_loader, device='cpu'):\n    \"\"\"Evaluates the model and computes multiple metrics.\"\"\"\n    model.eval()\n    predictions, labels, users = [], [], []\n\n    with torch.no_grad():\n        for batch in data_loader:\n            # Move data to the correct device (but avoid .to(device) to debug CUDA issues)\n            user_ids, item_ids, history, batch_labels = (x for x in batch)\n            outputs = model.forward_eval(user_ids.long(), item_ids.long(), history.long())\n\n            predictions.extend(outputs.cpu().numpy())\n            labels.extend(batch_labels.cpu().numpy())\n            users.extend(user_ids.cpu().numpy())\n\n    # Convert to NumPy arrays\n    predictions = np.array(predictions)\n    labels = np.array(labels)\n    users = np.array(users)\n\n    # Compute AUC & uAUC\n    auc = roc_auc_score(labels, predictions)\n    uauc = calculate_uauc(users, predictions, labels)\n\n    # Convert logits to probabilities using sigmoid\n    probabilities = 1 / (1 + np.exp(-predictions))\n\n    # Compute additional evaluation metrics\n    accuracy = accuracy_score(labels, (probabilities > 0.5).astype(int))\n    precision = precision_score(labels, (probabilities > 0.5).astype(int), zero_division=0)\n    recall = recall_score(labels, (probabilities > 0.5).astype(int), zero_division=0)\n    f1 = f1_score(labels, (probabilities > 0.5).astype(int), zero_division=0)\n    log_loss_value = log_loss(labels, probabilities)\n\n    # Return results as a dictionary\n    results = {\n        \"auc\": auc,\n        \"uauc\": uauc,\n        \"accuracy\": accuracy,\n        \"precision\": precision,\n        \"recall\": recall,\n        \"f1_score\": f1,\n        \"log_loss\": log_loss_value,\n    }\n\n    return results\n\ndef train_and_evaluate(sas_config, data_loaders, model, optimizer, criterion, early_stopper, eval_only=False, device='cpu'):\n    \"\"\"Train and evaluate the model.\"\"\"\n    train_loader, valid_loader, test_loader = data_loaders[\"train\"], data_loaders[\"valid\"], data_loaders[\"test\"]\n\n    for epoch in range(sas_config[\"epoch\"]):\n        if eval_only:\n            \n            val_log = evaluate_model(model, valid_loader, device)\n            valid_auc = val_log[\"auc\"]\n            if val_log is not None:\n                log_and_print_metrics(epoch, val_log)\n        else: \n            train_loss = train_one_epoch(model, train_loader, optimizer, criterion, device)\n            print(f\"Epoch {epoch}, Train Loss: {train_loss:.4f}\")\n    \n            if epoch % sas_config[\"eval_epoch\"] == 0:\n                val_log = evaluate_model(model, valid_loader, device)\n                valid_auc = val_log[\"auc\"]\n                if val_log is not None:\n                    log_and_print_metrics(epoch, val_log)\n    \n                if early_stopper.update(valid_auc):\n                    torch.save(model.state_dict(), sas_config[\"save_path\"] + \"checkpoint_{}.pth\".format(epoch))\n                \n                if early_stopper.should_stop():\n                    torch.save(model.state_dict(), sas_config[\"save_path\"] + \"checkpoint_best.pth\")\n                    print(\"Early stopping triggered.\")\n                    break\n\n    print(\"Training complete. Best AUC:\", early_stopper.best_score)\n\n\ndef log_and_print_metrics(cur_epoch, val_log):\n    \"\"\"\n    Saves validation metrics to a JSON file and prints them dynamically using key-value pairs.\n\n    Args:\n        cur_epoch (int): The current epoch number.\n        val_log (dict): A dictionary containing validation metrics such as loss, auc, uauc, etc.\n\n    Raises:\n        AssertionError: If val_log is empty.\n    \"\"\"\n    # Ensure val_log is not empty\n    assert val_log, \"Validation log is empty. Cannot log metrics.\"\n\n    # Prepare the metrics mes