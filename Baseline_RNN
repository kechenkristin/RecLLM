8:39.752660Z"}},"outputs":[],"execution_count":4},{"cell_type":"code","source":"import numpy as np\nfrom sklearn.preprocessing import label_binarize\nfrom sklearn.metrics import roc_auc_score\n\ndef calculate_uauc(users, probabilities, labels):\n    \"\"\"Computes unbiased AUC (uAUC) by averaging per-user AUC scores.\"\"\"\n    user_auc_scores = []\n    unique_users = np.unique(users)\n\n    for user in unique_users:\n        # ✅ Get valid indices for this user\n        user_indices = np.where((users == user) & (users < probabilities.shape[0]))[0]\n\n        # ✅ Ensure indices are within bounds\n        if len(user_indices) == 0 or user_indices.max() >= probabilities.shape[0]:\n            # print(f\"Skipping user {user} due to invalid indices.\")\n            continue\n\n        # ✅ Extract labels and probabilities correctly\n        user_labels = labels[user_indices]\n        user_probs = probabilities[user_indices]\n\n        # ✅ Ensure valid AUC computation\n        if len(np.unique(user_labels)) > 1:\n            try:\n                labels_one_hot = label_binarize(user_labels, classes=np.arange(user_probs.shape[1]))\n                user_auc = roc_auc_score(labels_one_hot, user_probs, average=\"macro\", multi_class=\"ovr\")\n                user_auc_scores.append(user_auc)\n            except ValueError:\n                continue  # Skip users with only one class present\n\n    return np.mean(user_auc_scores) if user_auc_scores else 0.0\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-03-20T12:08:39.754559Z","iopub.execute_input":"2025-03-20T12:08:39.754889Z","iopub.status.idle":"2025-03-20T12:08:39.771648Z","shell.execute_reply.started":"2025-03-20T12:08:39.754857Z","shell.execute_reply":"2025-03-20T12:08:39.770747Z"}},"outputs":[],"execution_count":5},{"cell_type":"markdown","source":"### Early Stopper","metadata":{}},{"cell_type":"code","source":"class EarlyStopper:\n    \"\"\"Class for early stopping.\"\"\"\n    def __init__(self, patience=20, metric=\"valid_auc\", higher_is_better=True):\n        self.metric = metric\n        self.best_score = None\n        self.patience = patience\n        self.counter = 0\n        self.higher_is_better = higher_is_better\n\n    def update(self, score):\n        \"\"\"Updates early stopping counter and checks for stopping condition.\"\"\"\n        if self.best_score is None or (self.higher_is_better and score > self.best_score) or (not self.higher_is_better and score < self.best_score):\n            self.best_score = score\n            self.counter = 0\n            return True\n        self.counter += 1\n        return False\n\n    def should_stop(self):\n        \"\"\"Returns True if training should stop.\"\"\"\n        return self.counter >= self.patience","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-03-20T12:08:39.772559Z","iopub.execute_input":"2025-03-20T12:08:39.772888Z","iopub.status.idle":"2025-03-20T12:08:39.789299Z","shell.execute_reply.started":"2025-03-20T12:08:39.772863Z","shell.execute_reply":"2025-03-20T12:08:39.788477Z"}},"outputs":[],"execution_count":6},{"cell_type":"markdown","source":"## Rec Models","metadata":{}},{"cell_type":"markdown","source":"### SASRec","metadata":{}},{"cell_type":"code","source":"import torch.nn.functional as F\n\nclass GRU4Rec(nn.Module):\n    def __init__(self, num_items, hidden_dim=256):\n        super(GRU4Rec, self).__init__()\n        self.item_embedding = nn.Embedding(num_items, hidden_dim)\n        self.gru = nn.GRU(hidden_dim, hidden_dim, batch_first=True)\n        self.fc = nn.Linear(hidden_dim, num_items)\n\n    def forward(self, sequences):\n        emb = self.item_embedding(sequences)\n        _, hidden = self.gru(emb)\n        return self.fc(hidden.squeeze(0))\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-03-20T12:08:39.790137Z","iopub.execute_input":"2025-03-20T12:08:39.790410Z","iopub.status.idle":"2025-03-20T12:08:39.810263Z","shell.execute_reply.started":"2025-03-20T12:08:39.790384Z","shell.execute_reply":"2025-03-20T12:08:39.809445Z"}},"outputs":[],"execution_count":7},{"cell_type":"markdown","source":"## Database Classes","metadata":{}},{"cell_type":"code","source":"class SequenceDataset(Dataset):\n    \"\"\"Dataset class for sequential data.\"\"\"\n    def __init__(self, data, max_len=25):\n        self.data = data\n        self.max_len = max_len\n\n    def __len__(self):\n        return len(self.data)\n\n    def __getitem__(self, index):\n        uid, iid, history, label = self.data[index]\n        history = np.pad(history[-self.max_len:], (self.max_len - len(history), 0), 'constant') if len(history) < self.max_len else np.array(history[-self.max_len:])\n        return uid, iid, history, label","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-03-20T12:08:39.812961Z","iopub.execute_input":"2025-03-20T12:08:39.813315Z","iopub.status.idle":"2025-03-20T12:08:39.825685Z","shell.execute_reply.started":"2025-03-20T12:08:39.813291Z","shell.execute_reply":"2025-03-20T12:08:39.824793Z"}},"outputs":[],"execution_count":8},{"cell_type":"markdown","source":"## Training & Evaluation Logic","metadata":{}},{"cell_type":"code","source":"def train_one_epoch(model, data_loader, optimizer, criterion, device):\n    \"\"\"Performs one training epoch for GRU4Rec.\"\"\"\n    model.train()\n    epoch_loss = 0.0\n\n    for batch in data_loader:\n        # ✅ Extract relevant inputs from batch\n        _, item_ids, history, labels = batch  # Ignoring `user_ids`\n        history, labels = history.to(device), labels.to(device)\n\n        # ✅ Forward pass (GRU4Rec predicts next item)\n        outputs = model(history.long())  # Shape: (batch_size, num_items)\n        \n        # ✅ Loss function should be CrossEntropyLoss\n        loss = criterion(outputs, labels.long())  # Ensure labels are LongTensor indices\n\n        # ✅ Backpropagation\n        optimizer.zero_grad()\n        loss.backward()\n        optimizer.step()\n\n        epoch_loss += loss.item()\n\n    return epoch_loss / len(data_loader)\n\n\ndef evaluate_model(model, data_loader, device='cpu'):\n    \"\"\"Evaluates GRU4Rec and computes AUC, uAUC, and other metrics.\"\"\"\n    model.eval()\n    predictions, labels, users, true_probs = [], [], [], []\n\n    with torch.no_grad():\n        for batch in data_loader:\n            user_ids, _, history, batch_labels = batch\n            history, batch_labels = history.to(device), batch_labels.to(device)\n\n            outputs = model(history.long())  # Shape: (batch_size, num_items)\n            probabilities = torch.softmax(outputs, dim=-1)  # Convert logits to probabilities\n\n            # ✅ Extract the probability assigned to the correct next item\n            true_item_probs = probabilities[torch.arange(probabilities.shape[0]), batch_labels]\n\n            # ✅ Get predicted item (highest probability)\n            predicted_items = torch.argmax(probabilities, dim=-1).cpu().numpy()\n            true_items = batch_labels.cpu().numpy()\n\n            # ✅ Store results\n            predictions.extend(predicted_items)\n            labels.extend(true_items)\n            users.extend(user_ids.cpu().numpy())\n            true_probs.extend(true_item_probs.cpu().numpy())\n\n    # Convert lists to NumPy arrays\n    predictions = np.array(predictions)\n    labels = np.array(labels)\n    users = np.array(users)\n    true_probs = np.array(true_probs)\n\n    # ✅ Convert labels to one-hot encoding\n    num_classes = probabilities.shape[1]\n    labels_one_hot = label_binarize(labels, classes=np.arange(num_classes))\n\n    # ✅ Compute AUC correctly\n    try:\n        auc = roc_auc_score(labels_one_hot, probabilities.cpu().numpy(), average=\"macro\", multi_class=\"ovr\")\n    except ValueError:\n        auc = 0.0  # If AUC calculation fails due to single-class labels\n\n    # ✅ Compute uAUC correctly\n    uauc = calculate_uauc(users, probabilities.cpu().numpy(), labels)\n\n    # ✅ Compute other evaluation metrics\n    accuracy = accuracy_score(labels, predictions)\n    precision = precision_score(labels, predictions, average=\"macro\", zero_division=0)\n    recall = recall_score(labels, predictions, average=\"macro\", zero_division=0)\n    f1 = f1_score(labels, predictions, average=\"macro\", zero_division=0)\n    log_loss_value = log_loss(labels, true_probs)\n\n    # ✅ Return results\n    results = {\n        \"auc\": auc,\n        \"uauc\": uauc,\n        \"accuracy\": accuracy,\n        \"precision\": precision,\n        \"recall\": recall,\n        \"f1_score\": f1,\n        \"log_loss\": log_loss_value,\n    }\n\n    return results\n\n    \n\ndef train_and_evaluate(sas_config, data_loaders, model, optimizer, criterion, early_stopper, eval_only=False, device='cpu'):\n    \"\"\"Train and evaluate the model.\"\"\"\n    train_loader, valid_loader, test_loader = data_loaders[\"train\"], data_loaders[\"valid\"], data_loaders[\"test\"]\n\n    for epoch in range(sas_config[\"epoch\"]):\n        if eval_only:\n            \n            val_log = evaluate_model(model, valid_loader, device)\n            valid_auc = val_log[\"auc\"]\n            if val_log is not None:\n                log_and_print_metrics(epoch, val_log)\n        else: \n            train_loss = train_one_epoch(model, train_loader, optimizer, criterion, device)\n            print(f\"Epoch {epoch}, Train Loss: {train_loss:.4f}\")\n    \n            if epoch % sas_config[\"eval_epoch\"] == 0:\n                val_log = evaluate_model(model, valid_loader, device)\n                valid_auc = val_log[\"auc\"]\n                if val_log is not None:\n                    log_and_print_metrics(epoch, val_log)\n    \n                if early_stopper.update(valid_auc):\n                    torch.save(model.state_dict(), sas_config[\"save_path\"] + \"checkpoint_{}.pth\".format(epoch))\n                \n                if early_stopper.should_stop():\n                    torch.save(model.state_dict(), sas_config[\"save_path\"] + \"checkpoint_best.pth\")\n                    print(\"Early stopping triggered.\")\n                    break\n\n    print(\"Training complete. Best AUC:\", early_stopper.best_score)\n\n\ndef log_and_print_metrics(cur_epoch, val_log):\n    \"\"\"\n    Saves validation metrics to a JSON file and prints them dynamically using key-value pairs.\n\n    Args:\n        cur_epoch (int): The current epoch number.\n        val_log (dict): A dictionary containing validation metrics such as loss, auc, uauc, etc.\n\n    Raises:\n        AssertionError: If val_log is empty.\n    \"\"\"\n    # Ensure val_log is not empty\n    assert val_log, \"Validation log is empty. Cannot log metrics.\"\n\n    # Prepare the metrics message dynamically\n    metrics_message = [f\"Epoch {cur_epoch} Metrics:\"]\n    for key, value in val_log.items():\n        # Handle float formatting for numeric values\n        if isinstance(value, (\n            \n            float, int)):\n            metrics_message.append(f\"  {key.capitalize()}: {value:.4f}\")\n        else:\n            metrics_message.append(f\"  {key.capitalize()}: {value}\")\n\n    # Join all parts into a single message\n    message = \"\\n\".join(metrics_message)\n\n    # Save metrics to JSON\n    log_data = {\"epoch\": cur_epoch, **val_log}  # Include the current epoch in the JSON entry\n    try:\n        with open(JSON_LOG_PATH, \"a\") as f:\n            f.write(json.dumps(log_data) + \"\\n\")  # Write each epoch's metrics on a new line\n    except Exception as e:\n        print(f\"Error saving metrics to JSON: {e}\")\n\n    # Print the message\n    print(message)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-03-20T12:08:39.827156Z","iopub.execute_input":"2025-03-20T12:08:39.827406Z","iopub.status.idle":"2025-03-20T12:08:39.844207Z","shell.execute_reply.started":"2025-03-20T12:08:39.827383Z","shell.execute_reply":"2025-03-20T12:08:39.843453Z"}},"outputs":[],"execution_count":9},{"cell_type":